diff --git a/modules/local/variants/bam_qc/main.nf b/modules/local/variants/bam_qc/main.nf
new file mode 100644
index 0000000..0f7426e
--- /dev/null
+++ b/modules/local/variants/bam_qc/main.nf
@@ -0,0 +1,45 @@
+// Keep only reads usable for variant calling (primary, mapped, MAPQ >= cutoff) and
+// measure per-reference coverage and the number of callable bases
+// (depth >= variant_min_depth), the denominator for SNV density / identity.
+process VARIANT_BAM_QC {
+    tag "$meta.id"
+    label 'process_low'
+
+    conda "bioconda::samtools=1.21"
+
+    input:
+    tuple val(meta), path(bam), path(fasta)
+
+    output:
+    tuple val(meta), path("${prefix}.filtered.bam"), path("${prefix}.filtered.bam.bai"), emit: bam
+    tuple val(meta), path("${prefix}.ref_coverage.txt")                                , emit: coverage
+    tuple val(meta), path("${prefix}.callable.tsv")                                    , emit: callable
+    path "versions.yml"                                                                , emit: versions
+
+    when:
+    task.ext.when == null || task.ext.when
+
+    script:
+    prefix = task.ext.prefix ?: "${meta.id}"
+    """
+    set -euo pipefail
+
+    # 0x904 = unmapped | secondary | supplementary
+    samtools view -b -q ${params.variant_min_mapq} -F 0x904 \\
+        --threads ${task.cpus} -o ${prefix}.filtered.bam ${bam}
+    samtools index ${prefix}.filtered.bam
+
+    samtools coverage -Q ${params.variant_min_baseq} ${prefix}.filtered.bam > ${prefix}.ref_coverage.txt
+
+    # -aa: every position of every reference, including references without reads
+    samtools depth -aa -q ${params.variant_min_baseq} ${prefix}.filtered.bam \\
+        | awk -v m=${params.variant_min_depth} 'BEGIN{OFS="\\t"} {n[\$1] += 0; if (\$3 >= m) n[\$1]++}
+                                                END{for (r in n) print r, n[r]}' \\
+        > ${prefix}.callable.tsv
+
+    cat <<-END_VERSIONS > versions.yml
+    "${task.process}":
+        samtools: \$(samtools --version | head -1 | sed 's/samtools //')
+    END_VERSIONS
+    """
+}
diff --git a/modules/local/variants/ivar_variants/main.nf b/modules/local/variants/ivar_variants/main.nf
new file mode 100644
index 0000000..10492d2
--- /dev/null
+++ b/modules/local/variants/ivar_variants/main.nf
@@ -0,0 +1,45 @@
+// iVar: frequency/depth-threshold caller on samtools mpileup, the de facto standard for
+// amplicon (ARTIC-like) viral data. Base quality is filtered by iVar itself (-q),
+// so mpileup runs with -Q 0 and without BAQ.
+process IVAR_VARIANTS {
+    tag "$meta.id"
+    label 'process_low'
+
+    conda "bioconda::ivar=1.4.4 bioconda::samtools=1.21"
+
+    input:
+    tuple val(meta), path(bam), path(bai), path(fasta)
+
+    output:
+    tuple val(meta), path("${prefix}.ivar.tsv"), emit: tsv
+    path "versions.yml"                        , emit: versions
+
+    when:
+    task.ext.when == null || task.ext.when
+
+    script:
+    prefix = task.ext.prefix ?: "${meta.id}"
+    """
+    set -euo pipefail
+    samtools faidx ${fasta}
+
+    samtools mpileup -aa -A -d 0 -B -Q 0 -q ${params.variant_min_mapq} \\
+        --reference ${fasta} ${bam} \\
+        | ivar variants \\
+            -p ${prefix}.ivar \\
+            -q ${params.variant_min_baseq} \\
+            -t ${params.variant_min_af} \\
+            -m ${params.variant_min_depth} \\
+            -r ${fasta}
+
+    # header-only table when nothing piled up
+    if [[ ! -s ${prefix}.ivar.tsv ]]; then
+        printf 'REGION\\tPOS\\tREF\\tALT\\tREF_DP\\tREF_RV\\tREF_QUAL\\tALT_DP\\tALT_RV\\tALT_QUAL\\tALT_FREQ\\tTOTAL_DP\\tPVAL\\tPASS\\n' > ${prefix}.ivar.tsv
+    fi
+
+    cat <<-END_VERSIONS > versions.yml
+    "${task.process}":
+        ivar: \$(ivar version | head -1 | sed 's/iVar version //')
+    END_VERSIONS
+    """
+}
diff --git a/modules/local/variants/lofreq_call/main.nf b/modules/local/variants/lofreq_call/main.nf
new file mode 100644
index 0000000..ec74d10
--- /dev/null
+++ b/modules/local/variants/lofreq_call/main.nf
@@ -0,0 +1,54 @@
+// LoFreq: quality-aware caller, sensitive down to ~1% allele frequency.
+//   viterbi    - realign around indels (fewer false SNVs next to indels)
+//   indelqual  - indel qualities: Dindel model for Illumina, uniform for Ion Torrent
+//   call       - SNVs (+ indels) with LoFreq's default dynamic strand-bias filter
+process LOFREQ_CALL {
+    tag "$meta.id"
+    label 'process_medium'
+
+    conda "bioconda::lofreq=2.1.5 bioconda::samtools=1.21"
+
+    input:
+    tuple val(meta), path(bam), path(bai), path(fasta)
+
+    output:
+    tuple val(meta), path("${prefix}.lofreq.vcf"), emit: vcf
+    path "versions.yml"                          , emit: versions
+
+    when:
+    task.ext.when == null || task.ext.when
+
+    script:
+    prefix = task.ext.prefix ?: "${meta.id}"
+    def indelqual = params.sequencing_platform == 'iontorrent' ?
+        "--uniform ${params.variant_indel_uniform_q}" : "--dindel -f ${fasta}"
+    def indels = params.variant_call_indels ? "--call-indels" : ""
+    def caller = task.cpus > 1 ? "call-parallel --pp-threads ${task.cpus}" : "call"
+    """
+    set -euo pipefail
+    samtools faidx ${fasta}
+
+    if [[ \$(samtools view -c ${bam}) -eq 0 ]]; then
+        printf '##fileformat=VCFv4.0\\n#CHROM\\tPOS\\tID\\tREF\\tALT\\tQUAL\\tFILTER\\tINFO\\n' > ${prefix}.lofreq.vcf
+    else
+        lofreq viterbi -f ${fasta} ${bam} | samtools sort -@ ${task.cpus} -o realn.bam -
+        lofreq indelqual ${indelqual} -o iq.bam realn.bam
+        samtools index iq.bam
+
+        lofreq ${caller} \\
+            -f ${fasta} \\
+            ${indels} \\
+            --min-bq ${params.variant_min_baseq} \\
+            --min-alt-bq ${params.variant_min_baseq} \\
+            --min-mq ${params.variant_min_mapq} \\
+            --min-cov ${params.variant_min_depth} \\
+            -o ${prefix}.lofreq.vcf \\
+            iq.bam
+    fi
+
+    cat <<-END_VERSIONS > versions.yml
+    "${task.process}":
+        lofreq: \$(lofreq version | grep version | sed 's/version: //')
+    END_VERSIONS
+    """
+}
diff --git a/modules/local/variants/prepare_references/main.nf b/modules/local/variants/prepare_references/main.nf
new file mode 100644
index 0000000..8ead79c
--- /dev/null
+++ b/modules/local/variants/prepare_references/main.nf
@@ -0,0 +1,108 @@
+// Build the per-sample reference set for read-based variant calling.
+//
+//   mode 'mmseqs'    : references = best MMseqs2 nucleotide hits of the sample's viral
+//                      contigs, sequences pulled from the same MMseqs2 nucleotide DB
+//                      (no separate genome collection needed)
+//   mode 'fasta'     : same selection, sequences pulled from a multi-FASTA
+//                      (e.g. locally downloaded NCBI genomes)
+//   mode 'fasta_all' : every sequence of the multi-FASTA (a fixed panel, e.g. bacterial
+//                      genomes); tophit/taxa inputs are ignored
+//
+// Near-identical candidates are then collapsed (MMseqs2 easy-linclust: made for high
+// identity, and unlike easy-cluster it needs no 4^15 nucleotide k-mer table in RAM) so
+// that reads are not split between two strains of the same virus during competitive mapping.
+// No output is emitted for a sample without usable references.
+process PREPARE_VARIANT_REFERENCES {
+    tag "$meta.id"
+    label 'process_medium'
+
+    conda "bioconda::mmseqs2=18.8cc5c bioconda::seqkit=2.8.2 conda-forge::pandas=2.2.2"
+
+    input:
+    tuple val(meta), path(tophit), path(taxa)
+    path  ref_source
+    val   mode
+
+    output:
+    tuple val(meta), path("${prefix}_references.fa") , emit: fasta, optional: true
+    tuple val(meta), path("${prefix}_references.tsv"), emit: table, optional: true
+    path "versions.yml"                              , emit: versions
+
+    when:
+    task.ext.when == null || task.ext.when
+
+    script:
+    prefix = task.ext.prefix ?: "${meta.id}"
+    def taxa_arg = taxa ? "--taxa ${taxa}" : ""
+    """
+    set -euo pipefail
+
+    # ── 1. candidate references ──────────────────────────────────────────────
+    if [[ "${mode}" == "fasta_all" ]]; then
+        printf "reference\\tref_length\\n" > cand_ref_candidates.tsv
+        seqkit fx2tab -n -i -l ${ref_source} | awk -F'\\t' 'BEGIN{OFS="\\t"} {print \$1, \$2}' >> cand_ref_candidates.tsv
+        tail -n +2 cand_ref_candidates.tsv | cut -f1 > cand_ref_candidates.txt
+    else
+        select_variant_references.py \\
+            --tophit ${tophit} \\
+            ${taxa_arg} \\
+            --min-aln-len ${params.variant_ref_min_aln_len} \\
+            --min-fident ${params.variant_ref_min_fident} \\
+            --max-refs ${params.variant_ref_max} \\
+            --prefix cand
+    fi
+
+    if [[ ! -s cand_ref_candidates.txt ]]; then
+        echo "No candidate references for ${meta.id}; skipping variant calling" >&2
+    else
+        # ── 2. extract sequences ─────────────────────────────────────────────
+        if [[ "${mode}" == "mmseqs" ]]; then
+            # same DB prefix detection as MMSEQS_EASYTAXONOMY
+            DB=\$(find -L "${ref_source}/" -maxdepth 1 -name "*.dbtype" | sed 's/\\.[^.]*\$//' | sed -e 'N;s/^\\(.*\\).*\\n\\1.*\$/\\1\\n\\1/;D')
+            for f in "\${DB}.lookup" "\${DB}_h.dbtype"; do
+                [[ -e "\$f" ]] || { echo "ERROR: \$f not found - cannot extract references from the MMseqs2 DB" >&2; exit 1; }
+            done
+            # accession -> internal DB key
+            awk 'NR==FNR {want[\$1]=1; next} (\$2 in want) {print \$1}' cand_ref_candidates.txt "\${DB}.lookup" > keys.txt
+            mkdir -p sub
+            mmseqs createsubdb keys.txt "\${DB}"   sub/refs   -v 1
+            mmseqs createsubdb keys.txt "\${DB}_h" sub/refs_h -v 1
+            mmseqs convert2fasta sub/refs cand.fa -v 1
+        else
+            seqkit grep -f cand_ref_candidates.txt ${ref_source} > cand.fa
+        fi
+        seqkit seq -n -i cand.fa > present.txt
+
+        missing=\$(grep -vxFf present.txt cand_ref_candidates.txt | wc -l || true)
+        [[ "\$missing" -gt 0 ]] && echo "WARNING: \$missing candidate reference(s) not found in ${ref_source}" >&2
+
+        # ── 3. collapse near-identical references ────────────────────────────
+        n=\$(grep -c '^>' cand.fa || true)
+        if [[ "\$n" -gt 1 ]] && awk 'BEGIN{exit !(${params.variant_ref_derep_id} > 0)}'; then
+            mmseqs easy-linclust cand.fa clu tmp_clu \\
+                --min-seq-id ${params.variant_ref_derep_id} \\
+                -c 0.8 --cov-mode 1 \\
+                --max-seq-len ${params.mmseqs_max_seq_len} \\
+                --threads ${task.cpus} -v 1
+            dereplicate_references.py --candidates cand_ref_candidates.tsv --clusters clu_cluster.tsv \\
+                --present present.txt --prefix ${prefix}
+        elif [[ "\$n" -gt 0 ]]; then
+            dereplicate_references.py --candidates cand_ref_candidates.tsv \\
+                --present present.txt --prefix ${prefix}
+        fi
+
+        if [[ -s ${prefix}_references.txt ]]; then
+            # upper-case bases: soft-masked references confuse some callers
+            seqkit grep -f ${prefix}_references.txt cand.fa | seqkit seq -u > ${prefix}_references.fa
+        else
+            rm -f ${prefix}_references.tsv
+        fi
+    fi
+
+    cat <<-END_VERSIONS > versions.yml
+    "${task.process}":
+        mmseqs: \$(mmseqs version)
+        seqkit: \$(seqkit version | sed 's/seqkit v//')
+    END_VERSIONS
+    """
+}
diff --git a/modules/local/variants/summarize/main.nf b/modules/local/variants/summarize/main.nf
new file mode 100644
index 0000000..7f83660
--- /dev/null
+++ b/modules/local/variants/summarize/main.nf
@@ -0,0 +1,47 @@
+// Caller-independent variant tables and the compact JSON consumed by the LLM report.
+process SUMMARIZE_VARIANTS {
+    tag "$meta.id"
+    label 'process_single'
+
+    conda "conda-forge::python=3.11 conda-forge::pandas=2.2.2"
+
+    input:
+    tuple val(meta), path(references), path(fasta), path(coverage), path(callable), path(calls)
+    val   caller
+
+    output:
+    tuple val(meta), path("${prefix}_variants.tsv")       , emit: variants
+    tuple val(meta), path("${prefix}_variant_summary.tsv"), emit: summary
+    tuple val(meta), path("${prefix}_variants.json")      , emit: json
+    path "versions.yml"                                   , emit: versions
+
+    when:
+    task.ext.when == null || task.ext.when
+
+    script:
+    prefix = task.ext.prefix ?: "${meta.id}"
+    """
+    summarize_variants.py \\
+        --sample ${meta.id} \\
+        --caller ${caller} \\
+        --platform ${params.sequencing_platform} \\
+        --calls ${calls} \\
+        --references ${references} \\
+        --ref-fasta ${fasta} \\
+        --coverage ${coverage} \\
+        --callable ${callable} \\
+        --min-depth ${params.variant_min_depth} \\
+        --min-af ${params.variant_min_af} \\
+        --min-alt-reads ${params.variant_min_alt_reads} \\
+        --consensus-af ${params.variant_consensus_af} \\
+        --iontorrent-max-hp ${params.variant_iontorrent_max_hp} \\
+        --max-report-per-ref ${params.variant_max_report_per_ref} \\
+        --prefix ${prefix}
+
+    cat <<-END_VERSIONS > versions.yml
+    "${task.process}":
+        python: \$(python --version 2>&1 | sed 's/Python //')
+        pandas: \$(python -c "import pandas; print(pandas.__version__)")
+    END_VERSIONS
+    """
+}
diff --git a/nextflow.config b/nextflow.config
index 515c27d..d7703c0 100644
--- a/nextflow.config
+++ b/nextflow.config
@@ -90,6 +90,45 @@ params {
     query_coverage_cutoff = 0.5
     mmseqs_max_seq_len = 1000000
 
+    // ── variant calling: reads -> reference genomes ─────────────────────────────
+    run_variant_calling       = true
+    // 'lofreq' (quality-aware, minor variants down to ~1%) | 'ivar' (amplicon standard)
+    variant_caller            = 'lofreq'
+    // 'illumina' | 'iontorrent'  (indel qualities in LoFreq, homopolymer-indel filter)
+    sequencing_platform       = 'illumina'
+    // where references come from:
+    //   'mmseqs'    - best nucleotide hits of the viral contigs, pulled from mmseqs_easy_taxonomy_refseq_viral_db
+    //   'fasta'     - same selection, pulled from variant_ref_fasta (e.g. local NCBI genomes)
+    //   'fasta_all' - every sequence of variant_ref_fasta (fixed panel, e.g. bacterial genomes)
+    variant_ref_source        = 'mmseqs'
+    variant_ref_fasta         = ''
+    // a contig's best hit must be at least this long / this identical to nominate its reference
+    variant_ref_min_aln_len   = 200
+    variant_ref_min_fident    = 0.7
+    // at most this many references per sample (most contig support first)
+    variant_ref_max           = 50
+    // collapse candidate references at >= this identity (0 = off) so that reads are not
+    // split between near-identical strains during competitive mapping
+    variant_ref_derep_id      = 0.95
+    // read filters and calling thresholds
+    variant_min_mapq          = 20
+    variant_min_baseq         = 20
+    variant_min_depth         = 10
+    variant_min_af            = 0.03
+    variant_min_alt_reads     = 3
+    // AF >= this: 'consensus' variant (majority base differs from reference); below: 'minor'
+    variant_consensus_af      = 0.5
+    variant_call_indels       = true
+    // LoFreq indel quality for Ion Torrent (Dindel model is Illumina-specific)
+    variant_indel_uniform_q   = 20
+    // Ion Torrent only: indels touching a reference homopolymer of >= this length are
+    // filtered (flag 'homopolymer_indel'), the platform's typical error mode
+    variant_iontorrent_max_hp = 4
+    // cap of variants per reference in the LLM JSON (the TSV keeps all)
+    variant_max_report_per_ref = 100
+    // BAMs of the reads mapped to the references (large; off by default)
+    save_variant_bams         = false
+
 }
 
 // clean working dir if complete successfully
diff --git a/subworkflows/local/variant_calling.nf b/subworkflows/local/variant_calling.nf
new file mode 100644
index 0000000..0c8e846
--- /dev/null
+++ b/subworkflows/local/variant_calling.nf
@@ -0,0 +1,128 @@
+//
+// Read-based variant calling against reference genomes.
+//
+//   1. per sample, choose references (MMseqs2 top hits of the viral contigs, or a fixed
+//      FASTA panel) and collapse near-identical ones
+//   2. map the cleaned reads competitively to all of the sample's references (bowtie2)
+//   3. keep primary reads with MAPQ >= variant_min_mapq, measure coverage/callable bases
+//   4. call variants with LoFreq or iVar (params.variant_caller)
+//   5. summarise into caller-independent tables + a compact JSON for the LLM report
+//
+
+include { PREPARE_VARIANT_REFERENCES                } from '../../modules/local/variants/prepare_references/main'
+include { BOWTIE2_BUILD as VARIANT_BOWTIE2_BUILD    } from '../../modules/nf-core/bowtie2/build/main'
+include { BOWTIE2_ALIGN as VARIANT_BOWTIE2_ALIGN    } from '../../modules/nf-core/bowtie2/align/main'
+include { VARIANT_BAM_QC                            } from '../../modules/local/variants/bam_qc/main'
+include { LOFREQ_CALL                               } from '../../modules/local/variants/lofreq_call/main'
+include { IVAR_VARIANTS                             } from '../../modules/local/variants/ivar_variants/main'
+include { SUMMARIZE_VARIANTS                        } from '../../modules/local/variants/summarize/main'
+
+workflow VARIANT_CALLING {
+
+    take:
+    ch_reads   // [ meta, reads ]          cleaned reads (CAT_FASTQ output)
+    ch_tophit  // [ meta, tophit_aln ]     MMSEQS_NUCLEOTIDES top hits (unused in fasta_all)
+    ch_taxa    // [ meta, filtered_taxa ]  PARSE_MMSEQS_NUCLEOTIDE_RESULTS table
+
+    main:
+    ch_versions = Channel.empty()
+
+    def caller = params.variant_caller.toString().toLowerCase()
+    def mode   = params.variant_ref_source.toString().toLowerCase()
+    if ( !(caller in ['lofreq', 'ivar']) ) {
+        error "variant_caller must be 'lofreq' or 'ivar', got '${params.variant_caller}'"
+    }
+    if ( !(mode in ['mmseqs', 'fasta', 'fasta_all']) ) {
+        error "variant_ref_source must be 'mmseqs', 'fasta' or 'fasta_all', got '${params.variant_ref_source}'"
+    }
+    if ( !(params.sequencing_platform in ['illumina', 'iontorrent']) ) {
+        error "sequencing_platform must be 'illumina' or 'iontorrent', got '${params.sequencing_platform}'"
+    }
+    if ( mode != 'mmseqs' && !params.variant_ref_fasta ) {
+        error "variant_ref_source='${mode}' needs variant_ref_fasta"
+    }
+
+    ref_source = mode == 'mmseqs' ?
+        file(params.mmseqs_easy_taxonomy_refseq_viral_db, checkIfExists: true) :
+        file(params.variant_ref_fasta, checkIfExists: true)
+
+    //
+    // 1. references per sample
+    //
+    if ( mode == 'fasta_all' ) {
+        ch_prepare_in = ch_reads.map { meta, reads -> [ meta, [], [] ] }
+    } else {
+        ch_prepare_in = ch_tophit.join(ch_taxa)
+    }
+
+    PREPARE_VARIANT_REFERENCES ( ch_prepare_in, ref_source, mode )
+    ch_versions = ch_versions.mix(PREPARE_VARIANT_REFERENCES.out.versions.first())
+
+    ch_refs = PREPARE_VARIANT_REFERENCES.out.fasta
+
+    //
+    // 2. competitive mapping to all references of the sample
+    //
+    VARIANT_BOWTIE2_BUILD ( ch_refs )
+    ch_versions = ch_versions.mix(VARIANT_BOWTIE2_BUILD.out.versions.first())
+
+    ch_map_in = ch_reads
+        .join(VARIANT_BOWTIE2_BUILD.out.index)
+        .join(ch_refs)
+        .multiMap { meta, reads, index, fasta ->
+            reads: [ meta, reads ]
+            index: [ meta, index ]
+            fasta: [ meta, fasta ]
+        }
+
+    VARIANT_BOWTIE2_ALIGN (
+        ch_map_in.reads,
+        ch_map_in.index,
+        ch_map_in.fasta,
+        false,   // save_unaligned
+        true     // sort_bam
+    )
+    ch_versions = ch_versions.mix(VARIANT_BOWTIE2_ALIGN.out.versions.first())
+
+    //
+    // 3. read filter + coverage / callable bases
+    //
+    VARIANT_BAM_QC ( VARIANT_BOWTIE2_ALIGN.out.bam.join(ch_refs) )
+    ch_versions = ch_versions.mix(VARIANT_BAM_QC.out.versions.first())
+
+    ch_call_in = VARIANT_BAM_QC.out.bam.join(ch_refs)   // [ meta, bam, bai, fasta ]
+
+    //
+    // 4. variant calling
+    //
+    if ( caller == 'lofreq' ) {
+        LOFREQ_CALL ( ch_call_in )
+        ch_calls    = LOFREQ_CALL.out.vcf
+        ch_versions = ch_versions.mix(LOFREQ_CALL.out.versions.first())
+    } else {
+        IVAR_VARIANTS ( ch_call_in )
+        ch_calls    = IVAR_VARIANTS.out.tsv
+        ch_versions = ch_versions.mix(IVAR_VARIANTS.out.versions.first())
+    }
+
+    //
+    // 5. tables for the report
+    //
+    ch_summary_in = PREPARE_VARIANT_REFERENCES.out.table
+        .join(ch_refs)
+        .join(VARIANT_BAM_QC.out.coverage)
+        .join(VARIANT_BAM_QC.out.callable)
+        .join(ch_calls)
+
+    SUMMARIZE_VARIANTS ( ch_summary_in, caller )
+    ch_versions = ch_versions.mix(SUMMARIZE_VARIANTS.out.versions.first())
+
+    emit:
+    variants   = SUMMARIZE_VARIANTS.out.variants   // [ meta, *_variants.tsv ]
+    summary    = SUMMARIZE_VARIANTS.out.summary    // [ meta, *_variant_summary.tsv ]
+    json       = SUMMARIZE_VARIANTS.out.json       // [ meta, *_variants.json ]
+    references = PREPARE_VARIANT_REFERENCES.out.table
+    calls      = ch_calls
+    bowtie2_log = VARIANT_BOWTIE2_ALIGN.out.log
+    versions   = ch_versions
+}
