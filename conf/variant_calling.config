// Publishing and per-process settings of the VARIANT_CALLING subworkflow.
// Kept apart from conf/modules.config (CRLF) so the module stays self-contained.
process {
    withName: PREPARE_VARIANT_REFERENCES {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/variants/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*_references.tsv"
        ]
    }

    withName: VARIANT_BOWTIE2_BUILD {
        publishDir = [ enabled: false ]
    }

    withName: VARIANT_BOWTIE2_ALIGN {
        ext.prefix = { "${meta.id}.variants" }
        // local mode keeps reads of strains that diverge from the reference at the read ends
        ext.args   = '--very-sensitive-local'
        publishDir = [
            path: { "${params.outdir}/variants/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.log"
        ]
    }

    withName: VARIANT_BAM_QC {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            [
                path: { "${params.outdir}/variants/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "*.{ref_coverage.txt,callable.tsv}"
            ],
            [
                path: { "${params.outdir}/variants/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "*.filtered.bam{,.bai}",
                enabled: params.save_variant_bams
            ]
        ]
    }

    withName: 'LOFREQ_CALL|IVAR_VARIANTS' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/variants/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.{lofreq.vcf,ivar.tsv}"
        ]
    }

    withName: SUMMARIZE_VARIANTS {
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/variants/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*_{variants.tsv,variant_summary.tsv,variants.json}"
        ]
    }
}
