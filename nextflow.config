params {
    // input and output params
    input = "/root/vera_demo/samplesheet/input.csv"
    outdir = "/output/"

    // Resource limits (overridden by --max_cpus / --max_memory on CLI)
    max_cpus   = 4
    max_memory = '8.GB'
    
    // paths to complete fastas with host or contaminant
    // if several contaminants/hosts, join all of them into single fasta respectively 
    host_index = "/dbs/"
    host_fasta = "/dbs/GRCh38_noalt_as.fna"
    contam_fasta = ""

    kraken2_db = ""
    viral_db_kraken2 = "/root/vera_demo/databases/kraken2_toydb/"
    mmseqs_easy_taxonomy_protein_db = "/root/vera_demo/databases/mmseqs_protein_toydb/"
    mmseqs_easy_taxonomy_refseq_viral_db = "/root/vera_demo/databases/mmseqs_nucleotide_toydb/"

    // Optional viral-only protein DB (directory) for a fast pre-screen before the full
    // protein search. Empty = pre-screen off, every ORF goes to mmseqs_easy_taxonomy_protein_db.
    // Build it as the viral subset of the SAME protein DB (mmseqs filtertaxseqdb --taxon-list 10239),
    // then the set of selected contigs does not change.
    mmseqs_viral_prescreen_db = ""
    // The full search accepts hits with E < 1 against the whole DB. E-values scale with DB size,
    // so this threshold must stay above (viral DB residues / full DB residues) to keep the
    // pre-screen a superset of what the full search would call viral.
    mmseqs_prescreen_evalue = 0.1
    // Must be >= the sensitivity of the full search (easy-taxonomy runs its search at -s 2).
    mmseqs_prescreen_sens = 4
    // pre-screen hit table and candidate list are intermediates, off by default
    save_mmseqs_prescreen_results = false


    // режим для переноса данных
    publish_dir_mode = 'copy'

    // side software additional params
    // FASTP
    fastp_discard_trimmed_fail = false
    fastp_save_trimmed_fail = false
    fastp_save_merged = false
    
    // run params
    fastp_qualified_quality = 15
    fastp_cut_mean_quality = 15
    fastp_reads_minlength = 15
    fastp_trim_front1 = null
    fastp_trim_front2 = null
    // true to save clipped reads to output
    save_clipped_reads = false

    // kraken2 params
    do_kraken2 = false
    kraken2_save_output_fastqc = false
    kraken2_save_reads_assignment = false

    // cat reads params
    save_clean_merged_reads = false

    // spades params
    spades_hmm_path = null
    // обычный (null), или rna, или viral, или metaviral
    spades_mode = null

    // SPAdes contigs are always published; scaffolds and the assembly graph only on request
    save_assembly_extras = false

    // BAM of the reads mapped back to the contigs. It is about as large as the input reads
    // and is only needed to compute the coverage table, which is always published.
    save_contig_alignments = false

    contig_len_filter = 200
    save_len_filtered_contigs = false

    min_orf_len = 50
    save_generated_orfs = false

    save_protein_filtered = false
    safe_sent_for_extension = true

    // mmseqs taxa tanks, comma separated
    mmseqs_lca_ranks = "superkingdom,order,family,genus"
    save_mmseqs_results = true
    save_mmseqs_protein_results = true

    hot_hit_size_match_cutoff = 0.8
    hot_hit_length_cutoff = 100
    query_coverage_cutoff = 0.5
    mmseqs_max_seq_len = 1000000

    // ── variant calling: reads -> reference genomes ─────────────────────────────
    run_variant_calling       = true
    // 'lofreq' (quality-aware, minor variants down to ~1%) | 'ivar' (amplicon standard)
    variant_caller            = 'lofreq'
    // 'illumina' | 'iontorrent'  (indel qualities in LoFreq, homopolymer-indel filter)
    sequencing_platform       = 'illumina'
    // where references come from:
    //   'mmseqs'    - best nucleotide hits of the viral contigs, pulled from mmseqs_easy_taxonomy_refseq_viral_db
    //   'fasta'     - same selection, pulled from variant_ref_fasta (e.g. local NCBI genomes)
    //   'fasta_all' - every sequence of variant_ref_fasta (fixed panel, e.g. bacterial genomes)
    variant_ref_source        = 'mmseqs'
    variant_ref_fasta         = ''
    // a contig's best hit must be at least this long / this identical to nominate its reference
    variant_ref_min_aln_len   = 200
    variant_ref_min_fident    = 0.7
    // at most this many references per sample (most contig support first)
    variant_ref_max           = 50
    // collapse candidate references at >= this identity (0 = off) so that reads are not
    // split between near-identical strains during competitive mapping
    variant_ref_derep_id      = 0.95
    // read filters and calling thresholds
    variant_min_mapq          = 20
    variant_min_baseq         = 20
    variant_min_depth         = 10
    variant_min_af            = 0.03
    variant_min_alt_reads     = 3
    // AF >= this: 'consensus' variant (majority base differs from reference); below: 'minor'
    variant_consensus_af      = 0.5
    variant_call_indels       = true
    // LoFreq indel quality for Ion Torrent (Dindel model is Illumina-specific)
    variant_indel_uniform_q   = 20
    // Ion Torrent only: indels touching a reference homopolymer of >= this length are
    // filtered (flag 'homopolymer_indel'), the platform's typical error mode
    variant_iontorrent_max_hp = 4
    // cap of variants per reference in the LLM JSON (the TSV keeps all)
    variant_max_report_per_ref = 100
    // BAMs of the reads mapped to the references (large; off by default)
    save_variant_bams         = false

}

// clean working dir if complete successfully
cleanup = false

// Load base.config and modules.config BEFORE profiles,
// so that profile-level process settings take priority.
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
includeConfig 'conf/variant_calling.config'

profiles {
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = true
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda', 'defaults']
        apptainer.enabled       = false
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        process {
            cpus   = { 2 * task.attempt }
            memory = { 4.GB * task.attempt }
            time   = { 1.h  * task.attempt }

            withLabel: 'process_single' {
                cpus   = 1
                memory = { 2.GB * task.attempt }
            }
            withLabel: 'process_medium' {
                cpus   = { Math.min(2 * task.attempt, 4) }
                memory = { Math.min(6 * task.attempt, 12).GB }
            }
            withLabel: 'process_high' {
                cpus   = { Math.min(4 * task.attempt, 16) }
                memory = { Math.min(12 * task.attempt, 80).GB }
            }
            withLabel: 'process_low' {
                cpus   = 1
                memory = { 2.GB * task.attempt }
            }
        }
    }
    // ── Demo / local profile ─────────────────────────────────────────────
    // All tools are assumed to be on PATH already (no containers pulled).
    // All CPU/memory values are capped to fit inside the Docker container.
    // Pass --max_cpus N and --max_memory 'X.GB' to control limits.
    local {
        singularity.enabled = false
        docker.enabled      = false
        conda.enabled       = false
        apptainer.enabled   = false

        process {
            // Потолок для ЛЮБОГО процесса, включая withName с фиксированными cpus
            resourceLimits = [
                cpus:   params.max_cpus as int,
                memory: (params.max_memory_gb as int).GB,
                time:   48.h
            ]

            cpus   = 1
            memory = 2.GB
            time   = 4.h

            withLabel: 'process_single' { cpus = 1; memory = 2.GB }
            withLabel: 'process_low'    { cpus = 1; memory = 2.GB }
            withLabel: 'process_medium' {
                cpus   = { Math.max(1, (params.max_cpus as int).intdiv(2)) }
                memory = { Math.max(4, (params.max_memory_gb as int).intdiv(2)).GB }
            }
            withLabel: 'process_high' {
                cpus   = { params.max_cpus as int }
                memory = { (params.max_memory_gb as int).GB }
            }
        }
    }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
// max number of simultaneous jobs per process
executor {
    queueSize       = 8
    submitRateLimit = '5 sec'
}


